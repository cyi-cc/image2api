APP_TITLE=MusesAPI

# Direct IP: http://YOUR_SERVER_IP:2000 + COOKIE_SECURE=false + WEB_BIND=0.0.0.0
# HTTPS domain: https://ai.example.com + COOKIE_SECURE=true
CORS_ORIGINS=http://YOUR_SERVER_IP:2000
COOKIE_SECURE=false
WEB_BIND=0.0.0.0
WEB_PORT=2000

# Optional overrides only. Docker Compose runs without this file.
# POSTGRES_PASSWORD=replace-with-a-long-random-password

# R2 is configured after login in 管理后台 → 设置 → Cloudflare R2 存储.
